# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME=GramCare
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173
AUTO_CREATE_TABLES=false

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Option A: Neon managed Postgres (free tier)
# DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>/neondb?ssl=require
# Option B: Local Docker
DATABASE_URL=postgresql+asyncpg://gramcare_user:gramcare_password@localhost:5432/gramcare

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=1
REDIS_CELERY_DB=2

# ─── MinIO (S3-compatible object storage) ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_MEDIA=gramcare-media
MINIO_BUCKET_DOCUMENTS=gramcare-docs
MINIO_USE_SSL=false

# ─── JWT Auth ────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6

# ─── OTP ─────────────────────────────────────────────────────────────────────
CONSOLE_OTP=true              # true = print OTP to console (dev mode)

# ─── WebRTC (peer-to-peer, no paid SFU) ──────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302
TURN_ENABLED=false
TURN_URL=turn:localhost:3478
TURN_USERNAME=gramcare
TURN_CREDENTIAL=gramcarepass
# TURN_URL may list several, e.g. turn:host:3478,turns:host:443?transport=tcp
# Or skip self-hosting and use a hosted TURN credentials endpoint (Metered etc.):
TURN_CREDENTIALS_URL=

# ─── Demo / scheduling ───────────────────────────────────────────────────────
DEMO_LOGIN_ENABLED=false       # one-click demo accounts without DEBUG
CLINIC_UTC_OFFSET_MINUTES=330  # doctors' hours are clinic-local (IST)

# ─── Sync service ────────────────────────────────────────────────────────────
SYNC_MAX_BATCH_SIZE=100
SYNC_CHECKPOINT_INTERVAL_SECONDS=30

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_OTP_PER_HOUR=5
RATE_LIMIT_API_PER_MINUTE=120
